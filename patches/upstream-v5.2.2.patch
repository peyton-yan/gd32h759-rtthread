+            JEDEC ID 0xC8481AFF), via OSPI0 + OSPIM port 0.
+            Pins: NCS=PB6(AF10), CLK=PB2(AF9),
+            IO0~IO7 = PD11/PD12(AF9), PA3(AF6), PD13(AF9),
+            PD4/PD5/PD6/PD7(AF10). DQS not connected (no-DQS mode only).
+            Jumper prerequisite: JP61 to (2,3) = OSPI side.
+            Conflicts: PB6 with I2C0_SCL / DCI_D5 (both unused).
+            Memory-mapped base: 0x90000000.
+            Chip command layer: gd25x512me.c (from the official demo).
+            Shell cmds: ospi_id / ospi_test1 / ospi_test8 / ospi_mmap.
+
+    config BSP_USING_SDIO
+        bool "Enable SDIO (TF card)"
+        select RT_USING_SDIO
+        select RT_USING_DFS
+        select RT_USING_DFS_ELMFAT
+        select RT_USING_DFS_MNTTABLE
+        default n
+
+    config BSP_SDIO_AUTO_MOUNT
+        bool "Auto mount sd0 to / (event-driven watcher)"
+        default y
+        depends on BSP_USING_SDIO
+        help
+            Card detection completes asynchronously in the mmcsd_detect
+            thread, so the DFS mount_table's mount-at-boot is doomed to
+            fail. This option starts an event-driven watcher thread: mount
+            sd0 to / on the insertion event from mmcsd_wait_cd_changed(),
+            umount on removal.
+
+    config BSP_SDIO_1BIT
+        bool "Force SDIO 1-bit bus (JP52 shared with LCD)"
+        default y
+        depends on BSP_USING_SDIO
+        help
+            On this board PC11 is both SDIO_D3 and LCD_B4, physically
+            selected by JP52. With JP52 on the LCD side (mandatory when
+            TLI is on), D3 does not exist and 4-bit mode dies right after
+            the ACMD6 bus-width switch. 1-bit mode uses only CLK/CMD/D0,
+            coexists with the LCD, ~6MB/s @ 50MHz - enough for CSV logging.
+            Disable this option to restore 4-bit when TLI is off or on a
+            custom board without this mux.
+
+    config BSP_SDIO_REPROBE_CMD
+        bool "Enable sdprobe shell cmd (board without CD pin)"
+        default y
+        depends on BSP_USING_SDIO
+        help
+            Only needed on boards whose socket CD (Card Detect) signal is
+            not wired to the MCU: without CD the framework never gets
+            hot-plug events, so run sdprobe in the shell after re-inserting
+            a card. On a custom board with CD wired to the MCU, the right
+            approach is a GPIO EXTI + debounce + mmcsd_change() with a
+            truthful get_card_status() - not implemented in this project;
+            disable this option in that case.
+
+    config BSP_USING_TLI
+        bool "Enable TLI LCD (480x272 RGB panel)"
+        default n
+        select BSP_USING_SDRAM
+        help
+            Board-level conflicts: enabling TLI requires disabling ENET
+            (PG11/13/14); JP52 must be set to (1,2)=TLI (SDIO degrades to
+            1-bit mode); DAC0_OUT1(PA5) gives way to LCD_R4.
+
+    config BSP_USING_TOUCH
+        bool "Enable GT911 touch (software I2C)"
+        default n
+        depends on BSP_USING_TLI
+
+    config BSP_USING_RTC
+        bool "Enable RTC calendar (LXTAL, IRC32K fallback)"
+        default n
+        select RT_USING_RTC
+
+    config BSP_USING_HPDF
+        bool "Enable HPDF (onboard dual MP34DT06J digital mics)"
+        default n
+        help
+            Onboard dual PDM digital microphones: HPDF_CKOUT=PB0,
+            HPDF_DATA=PB1 (both AF6). Jumpers JP55/JP56 to (2,3) = HPDF
+            side. PDM clock 1MHz (PER=HXTAL 25MHz / 25), SINC4 filter with
+            64x decimation -> 15.625kHz stereo PCM, DMA1 CH1/CH3 circular
+            double buffer. Shell cmds: hpdf_test (live level meter),
+            hpdf_dbg (register/edge forensics).
+            Pair with BSP_USING_I2S1 for earphone passthrough, and with
+            BSP_USING_ST7789 for on-LCD waveform.
+
+    config BSP_HPDF_DATA_ON_PC3
+        bool "HPDF data pin -> PC3 (JP7-35) instead of PB1"
+        default n
+        depends on BSP_USING_HPDF && !BSP_USING_I2S1
+        help
+            Board-repair option for specimens whose PB1 PCB trace is
+            broken (verdict confirmed by the official HPDF_I2S demo also
+            producing silence). Reroutes HPDF_DATAIN1 to its alternate
+            pin PC3 (AF3, landing on extension header JP7-35).
+            Wiring: pull the JP55 cap, dupont-wire JP55-3 (mic DOUT side)
+            to JP7-35.
+            Mutually exclusive with BSP_USING_I2S1 (PC3 is I2S1_SD);
+            earphone playback must be disabled while this is on.
+
+    config BSP_USING_DCI_OV2640
+        bool "Enable DCI camera (OV2640)"
+        default n
+        depends on BSP_USING_I2C1
+        help
+            OV2640 camera module, jumpers JP60/JP61/JP62/JP63 to DCI side:
+            SCCB  = hardware I2C1 (SCL=PH4 / SDA=PB11, AF4 open-drain)
+            XCLK  = PA8 (CKOUT0, HXTAL/3 ~ 8.33MHz)
+            PIXCLK=PE3  VSYNC=PB7  HSYNC=PA4
+            D0~D7 = PC6/PH10/PC8/PC9/PE4/PB6/PE5/PE6 (AF13)
+            DMA1 CH7 circular -> SDRAM 0xC0000000, 320x240 RGB565.
+            Depends on BSP_USING_I2C1 (SCCB rides the "i2c1" bus of
+            drv_i2c_h7). Note: PB6(D5) conflicts with OSPI, PC9(D3) with
+            SDIO_D1 (keep SDIO in 1-bit mode).
+            NOTE: this unit is currently parked - the camera connector on
+            this specimen shows hardware degradation (official demo hangs
+            identically). Enable only with a known-good module/board.
+            
+    config BSP_USING_USB_CDC
+        bool "Enable USBHS0 CDC ACM (CherryUSB, virtual COM)"
+        default n
+
+    source "$(BSP_DIR)/../libraries/gd32_drivers/Kconfig"
 endmenu
 
 menu "Board extended module Drivers"
 
-endmenu
+    config BSP_USING_ST7789
+        bool "Enable ST7789 SPI LCD (240x240)"
+        default n
+        depends on BSP_USING_SPI4
+        help
+            8-pin ST7789 module, dupont-wired to the extension headers:
+            SCL->JP8-37(PH6/SCK)  SDA->JP7-27(PF9/MOSI)  CS->JP7-24(PF6)
+            DC->JP10-29(PB5)  RES->JP10-28(PB4)
+            Keep away from PA9/PA10 (console UART0)!
+            BLK left floating = always on (on-board pull-up), VCC=3.3V.
+            The driver lives in applications/ (a peripheral of a
+            peripheral); see applications/SConscript for the gating.
 
 endmenu
 
+endmenu
